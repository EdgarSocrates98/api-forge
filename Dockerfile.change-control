FROM python:3.12-slim

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN python -m pip install --no-cache-dir .

EXPOSE 8765
ENV PYTHONUNBUFFERED=1

CMD ["apiforge", "change-control", "serve", "--run-dir", "/data/run", "--host", "0.0.0.0", "--port", "8765", "--token-env", "APIFORGE_HOST_TOKEN", "--tls-cert", "/tls/server.crt", "--tls-key", "/tls/server.key"]
