{
  "schema": "forge/SpecialistAgenticManifest/v1",
  "provider": "api-forge",
  "version": "0.3.4",
  "cli": "apiforge",
  "cli_entry": "apiforge.cli:app",
  "workflows": [
    {
      "id": "analyze",
      "mode": "DIRECT_CAPABILITY",
      "command": [
        "{cli}",
        "analyze",
        "{target}"
      ],
      "description": "Analyze API/contract surfaces",
      "read_only": true
    },
    {
      "id": "doctor",
      "mode": "DIAGNOSTIC_ONLY",
      "command": [
        "{cli}",
        "doctor"
      ],
      "description": "Environment health",
      "read_only": true
    }
  ],
  "skills": [],
  "agents": [
    "api-adversarial-critic",
    "api-architecture-reviewer",
    "api-codegen-engineer",
    "api-contract-architect",
    "api-data-access-architect",
    "api-debate-referee",
    "api-dx-docs-reviewer",
    "api-event-driven-architect",
    "api-governance-reviewer",
    "api-graph-data-architect",
    "api-infra-reviewer",
    "api-load-capacity-engineer",
    "api-modernization-specialist",
    "api-observability-engineer",
    "api-observability-integration-engineer",
    "api-operations-engineer",
    "api-orchestrator",
    "api-performance-engineer",
    "api-planner",
    "api-platform-selector",
    "api-release-guardian",
    "api-resilience-engineer",
    "api-security-reviewer",
    "api-task-spec-reviewer",
    "api-test-strategist",
    "api-verifier"
  ],
  "coordinators": [],
  "mcp_command": [
    "apiforge-mcp"
  ],
  "host_adapters": [
    "claude",
    "devin",
    "codex",
    "copilot"
  ],
  "requires_network": false,
  "requires_credentials": false,
  "read_only_default": true
}
