{
  "forge_id": "api-forge",
  "package": "apiforge",
  "distribution": "apiforge-af",
  "cli": "apiforge",
  "python": ">=3.12",
  "mcp_server_name": "apiforge",
  "mcp_command": [
    "apiforge-mcp"
  ],
  "extras": [
    "mcp"
  ],
  "lab": {
    "command": [
      "{checkout}/.venv/bin/python",
      "scripts/lab/apiforge_lab.py",
      "--checkout",
      "{checkout}",
      "--mode",
      "{mode}",
      "--result-out",
      "{receipt}"
    ],
    "receipt": ".forge/lab-result.json",
    "modes": [
      "A"
    ],
    "suite": "api-forge-lab",
    "timeout_s": 120
  }
}
